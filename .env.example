# === LLM API KEYS (free tiers) ===
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
TOGETHER_API_KEY_1=
CEREBRAS_API_KEY_1=
DEEPSEEK_API_KEY_1=
HF_API_KEY_1=
GITHUB_MODELS_TOKEN=

# === Infra ===
REDIS_URL=redis://localhost:6379
ORCHESTRATOR_PORT=4000
DASHBOARD_PORT=3000
WS_PORT=4001

# === Worker machine config ===
# Comma-separated agent ids this machine should run.
# Machine A (orchestrator host) usually runs pm + a couple others.
# Leave blank on the orchestrator machine to run ALL agents locally (single-machine mode).
WORKER_ROLES=

# === Local fallback (Ollama) ===
OLLAMA_ENABLED=true
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
