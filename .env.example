# === LLM API KEYS (free tiers) ===
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
TOGETHER_API_KEY_1=
CEREBRAS_API_KEY_1=
DEEPSEEK_API_KEY_1=
HF_API_KEY_1=
GITHUB_MODELS_TOKEN=

# === Infra ===
REDIS_URL=redis://localhost:6379
ORCHESTRATOR_PORT=4000
DASHBOARD_PORT=3000
WS_PORT=4001

# === Worker machine config ===
# Comma-separated agent ids this machine should run.
# Machine A (orchestrator host) usually runs pm + a couple others.
# Leave blank on the orchestrator machine to run ALL agents locally (single-machine mode).
WORKER_ROLES=

# === Local fallback (Ollama) ===
OLLAMA_ENABLED=true
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# === Deploy ===
# Set VERCEL_TOKEN to enable auto-deploy to Vercel after pipeline finishes.
# If unset, output is served locally on PREVIEW_PORT instead.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
PREVIEW_PORT=4002

# === Blockchain / Agent Economy ===
# Set CHAIN_ENABLED=true to activate on-chain wallet + escrow features.
# Requires Base Sepolia ETH for gas (free faucet: https://faucet.quicknode.com/base/sepolia)
CHAIN_ENABLED=false
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ESCROW_CONTRACT_ADDRESS=
# Amount in wei deposited per task assignment (1000 wei ≈ $0.000000003 — effectively symbolic)
TASK_ESCROW_WEI=1000
# Deployer account (contract owner) — run `npm run generate:wallets` to populate all keys
DEPLOYER_PRIVATE_KEY=

# === Per-Agent Wallets (auto-generated by `npm run generate:wallets`) ===
AGENT_WALLET_PRIVATE_KEY_pm=
AGENT_WALLET_ADDRESS_pm=
AGENT_WALLET_PRIVATE_KEY_idea=
AGENT_WALLET_ADDRESS_idea=
AGENT_WALLET_PRIVATE_KEY_designer=
AGENT_WALLET_ADDRESS_designer=
AGENT_WALLET_PRIVATE_KEY_html_dev=
AGENT_WALLET_ADDRESS_html_dev=
AGENT_WALLET_PRIVATE_KEY_css_dev=
AGENT_WALLET_ADDRESS_css_dev=
AGENT_WALLET_PRIVATE_KEY_js_dev=
AGENT_WALLET_ADDRESS_js_dev=
AGENT_WALLET_PRIVATE_KEY_animation_dev=
AGENT_WALLET_ADDRESS_animation_dev=
AGENT_WALLET_PRIVATE_KEY_backend_dev=
AGENT_WALLET_ADDRESS_backend_dev=
AGENT_WALLET_PRIVATE_KEY_db_dev=
AGENT_WALLET_ADDRESS_db_dev=
AGENT_WALLET_PRIVATE_KEY_debugger_1=
AGENT_WALLET_ADDRESS_debugger_1=
AGENT_WALLET_PRIVATE_KEY_debugger_2=
AGENT_WALLET_ADDRESS_debugger_2=
AGENT_WALLET_PRIVATE_KEY_docs_writer=
AGENT_WALLET_ADDRESS_docs_writer=
